{
  "collection": "articles", 
  "query": {
    "$and": [
      {
        "sql": {
          "where": {
            "id": {"$like": "doc-%"}
          }
        }
      },
      {
        "$or": [
          {
            "search": {
              "term": "Go",
              "fields": ["title"],
              "weights": {"title": 3}
            }
          },
          {
            "sql": {
              "where": {
                "body": {"$contains": "test"}
              }
            }
          }
        ]
      }
    ]
  },
  "result": {
    "fields": ["id", "title", "body"],
    "limit": 10,
    "order_by": [
      {"field": "id", "direction": "asc"}
    ]
  }
}